APP_NAME=leetcode-ai-coach
APP_ENV=development
DEBUG=True
SECRET_KEY=change-me
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://leetcode:password@localhost:5432/leetcode_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=0
DB_ECHO=False

REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=False

LEETCODE_API_URL=https://leetcode.com/graphql
LEETCODE_RATE_LIMIT_PER_MINUTE=100

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.2

JWT_SECRET=change-me-jwt
JWT_REFRESH_SECRET=change-me-refresh
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

ENCRYPTION_KEY=

EXTENSION_ORIGIN=chrome-extension://your-extension-id
DASHBOARD_ORIGIN=http://localhost:3000

LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=
PROMETHEUS_PORT=9090

RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
