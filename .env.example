# ── Backend ─────────────────────────────────────────────────────────

# PostgreSQL async connection string
# Docker: use "postgres" as host (the service name in docker-compose.yml)
# Local:  use "localhost"
DATABASE_URL=postgresql+asyncpg://codemirror:codemirror@localhost:5432/codemirror

# Groq API key — get yours at https://console.groq.com
GROQ_API_KEY=

# JWT signing secrets — generate with: openssl rand -hex 32
# MUST be different values, MUST be at least 32 characters
JWT_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# Chrome extension origin for CORS
# After loading the extension, copy the ID from chrome://extensions
# Format: chrome-extension://<your-extension-id>
EXTENSION_ORIGIN=chrome-extension://your-extension-id

# Dashboard origin for CORS
DASHBOARD_ORIGIN=http://localhost:3000

# ── Postgres container (Docker only) ────────────────────────────────

POSTGRES_DB=codemirror
POSTGRES_USER=codemirror
# Change this in production!
POSTGRES_PASSWORD=codemirror

# ── Dashboard ────────────────────────────────────────────────────────

# Backend URL the browser/dashboard calls
# In production: replace with your deployed backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Optional / Advanced ──────────────────────────────────────────────

# Access token expiry in minutes (default: 15)
# ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token expiry in days (default: 30)
# REFRESH_TOKEN_EXPIRE_DAYS=30

# Groq model override (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
