# ═══════════════════════════════════════════════════════════════════
# CodeMirror AI Coach — Environment Variables
# ═══════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────
APP_NAME=codemirror-ai-coach
APP_ENV=development
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
API_V1_PREFIX=/api/v1

# ── Database (PostgreSQL) ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://codemirror:codemirror@localhost:5432/codemirror
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=0
DB_ECHO=False

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ── Celery ────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=False

# ── Groq AI ───────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.2

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=change-me-access-secret-256-bits
JWT_REFRESH_SECRET=change-me-refresh-secret-256-bits
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Encryption ────────────────────────────────────────────────────
ENCRYPTION_KEY=your-fernet-key-base64-here

# ── CORS ──────────────────────────────────────────────────────────
EXTENSION_ORIGIN=chrome-extension://your-extension-id
DASHBOARD_ORIGIN=http://localhost:3000

# ── LeetCode ──────────────────────────────────────────────────────
LEETCODE_API_URL=https://leetcode.com/graphql
LEETCODE_RATE_LIMIT_PER_MINUTE=100

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Monitoring ────────────────────────────────────────────────────
SENTRY_DSN=
PROMETHEUS_PORT=9090

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ── Docker Compose Overrides ──────────────────────────────────────
POSTGRES_DB=codemirror
POSTGRES_USER=codemirror
POSTGRES_PASSWORD=codemirror
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
