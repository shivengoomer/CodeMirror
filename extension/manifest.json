{
  "manifest_version": 3,
  "name": "CodeMirror",
  "description": "Tracks failed coding submissions and surfaces recurring mistake patterns across LeetCode, GeeksForGeeks, and HackerRank.",
  "version": "0.1.0",
  "permissions": ["storage", "cookies"],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://*.leetcode.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "dist/popup.html",
    "default_title": "CodeMirror — Mistake Tracker"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "dist/lc-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/lc-main.js",
        "dist/popup.html",
        "dist/popup.css"
      ],
      "matches": [
        "https://leetcode.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:8000 http://localhost:3000 https://leetcode.com https://*.leetcode.com"
  }
}
